# Desktop frontend embed: track the placeholder, ignore build-time copies.
# The packaging script overwrites frontend/dist/ with the real vite output;
# the placeholder index.html is committed so `go build ./...` always works.
!cmd/which-model-desktop/frontend/dist/index.html
