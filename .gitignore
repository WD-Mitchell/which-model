# macOS
.DS_Store

# Python bytecode (legacy prototype)
__pycache__/
*.pyc

# Editor
*.swp
*.swo
*~
.idea/
.vscode/

# Go
/which-model
/which-model-desktop
/wm
/wmodel
/whichm
*.exe
*.test

# Release artifacts (npm packaging)
/dist/
npm/which-model-*/which-model

# Desktop monorepo (S01)
node_modules/
apps/desktop/dist/
bin/
cmd/which-model-desktop/build/bin/

# Desktop build artifacts
cmd/which-model-desktop/frontend/
*.app

# Desktop frontend embed: track the placeholder, ignore build-time copies.
# The packaging script overwrites frontend/dist/ with the real vite output;
# the placeholder index.html is committed so `go build ./...` always works.
!cmd/which-model-desktop/frontend/dist/index.html

# TypeScript incremental cache (`tsc -b` writes tsconfig.tsbuildinfo)
*.tsbuildinfo

# Bundler / test caches
.vite/
coverage/
.pytest_cache/

# Logs
*.log
pnpm-debug.log*

# Local secrets (README: never commit ARTIFICIAL_ANALYSIS_API)
.env
.env.*
!.env.example
